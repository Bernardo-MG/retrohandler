# Auto detect text files and perform LF normalization
* text=auto

# Known text files
*.css           text eol=lf diff=css
*.js            text
*.json          text eol=lf
*.htm           text diff=html
*.html          text eol=lf diff=html
*.properties    text
*.sass          text
*.sh            text
*.md            text
*.ts            text eol=lf
*.tsx           text eol=lf
*.cjs           text eol=lf
*.txt           text
*.xml           text
*.yml           text
*.sql           text eol=lf
