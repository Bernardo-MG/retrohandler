{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-tests",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/main/scanner.ts",
    "src/main/scanner/**/*.ts",
    "src/shared.ts"
  ]
}
